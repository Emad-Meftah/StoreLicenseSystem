      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoreLicense.Core\StoreLicense.Core.csproj" />
    <ProjectReference Include="..\StoreLicense.Infrastructure\StoreLicense.Infrastructure.csproj" />
  </ItemGroup>

</Project>
